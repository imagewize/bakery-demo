{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"radius": true,
			"radiusSizes": [
				{ "name": "None", "slug": "none", "size": "0" },
				{ "name": "Button", "slug": "button", "size": "0.3125rem" },
				{ "name": "Card", "slug": "card", "size": "0" }
			]
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "name": "Base", "slug": "base", "color": "#FBF4E4" },
				{ "name": "Contrast", "slug": "contrast", "color": "#3B2415" },
				{ "name": "Main", "slug": "main", "color": "#3B2415" },
				{ "name": "Tertiary", "slug": "tertiary", "color": "#F5EBD9" },
				{ "name": "Border Light", "slug": "border-light", "color": "#D9C8AD" },
				{ "name": "Secondary", "slug": "secondary", "color": "#755D43" },
				{ "name": "Main Accent", "slug": "main-accent", "color": "#755D43" },
				{ "name": "Primary", "slug": "primary", "color": "#9C3524" },
				{ "name": "Primary Alt", "slug": "primary-alt", "color": "#2A1608" },
				{ "name": "Primary Accent", "slug": "primary-accent", "color": "#E3D2AC" },
				{ "name": "Accent", "slug": "accent", "color": "#9C3524" },
				{ "name": "White", "slug": "white", "color": "#FFFDF6" },
				{ "name": "Terracotta", "slug": "terracotta", "color": "#9C3524" },
				{ "name": "Sand Deep", "slug": "sand-deep", "color": "#D9C8AD" }
			]
		},
		"custom": {
			"color": {
				"control-border": "#755D43",
				"cream": "#EFE1C3",
				"cream-hover": "#E3D2AC",
				"field": "#FFFDF6"
			},
			"spacing": {
				"content-padding": "clamp(1.25rem, 5vw, 2.5rem)"
			}
		},
		"layout": {
			"contentSize": "72rem",
			"wideSize": "72rem"
		},
		"spacing": {
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "2X-Small", "slug": "2-x-small", "size": "clamp(0.25rem, 1.5vw, 0.5rem)" },
				{ "name": "X-Small", "slug": "x-small", "size": "clamp(0.375rem, 2vw, 0.75rem)" },
				{ "name": "Small", "slug": "small", "size": "clamp(0.5rem, 2.5vw, 1rem)" },
				{ "name": "Medium", "slug": "medium", "size": "clamp(1.5rem, 4vw, 2rem)" },
				{ "name": "Large", "slug": "large", "size": "clamp(2rem, 5vw, 3rem)" },
				{ "name": "X-Large", "slug": "x-large", "size": "clamp(3rem, 7vw, 5rem)" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Body",
					"slug": "body",
					"fontFamily": "'Hanken Grotesk', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/hanken-grotesk-variable-wght.woff2" ]
						}
					]
				},
				{
					"name": "Display",
					"slug": "display",
					"fontFamily": "'Fraunces', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"src": [ "file:./assets/fonts/fraunces-variable-wght.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "name": "XX-Small", "slug": "xx-small", "size": "0.75rem" },
				{ "name": "X-Small", "slug": "x-small", "size": "0.8125rem" },
				{ "name": "Small", "slug": "small", "size": "0.875rem" },
				{ "name": "Base", "slug": "base", "size": "1rem" },
				{ "name": "Medium", "slug": "medium", "size": "1.0625rem" },
				{ "name": "Large", "slug": "large", "size": "1.375rem" },
				{ "name": "X-Large", "slug": "x-large", "size": "clamp(1.875rem, 1.3rem + 2.2vw, 2.625rem)" },
				{ "name": "XX-Large", "slug": "xx-large", "size": "clamp(2.5rem, 1.1rem + 6.5vw, 5.25rem)" },
				{ "name": "Display", "slug": "display", "size": "clamp(2.5rem, 1.1rem + 6.5vw, 5.25rem)" }
			]
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--medium)",
			"padding": {
				"top": "0",
				"right": "var(--wp--custom--spacing--content-padding)",
				"bottom": "0",
				"left": "var(--wp--custom--spacing--content-padding)"
			}
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"textDecoration": "underline",
					"textUnderlineOffset": "4px",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"width": "3px",
						"style": "solid",
						"offset": "3px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.08",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "360"
				},
				"spacing": {
					"margin": {
						"top": "0"
					}
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				},
				"spacing": {
					"margin": {
						"top": "0"
					}
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)",
					"background": "#EFE1C3"
				},
				"border": {
					"radius": "5px"
				},
				"spacing": {
					"padding": {
						"top": "1.0625rem",
						"right": "1.75rem",
						"bottom": "1.0625rem",
						"left": "1.75rem"
					}
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)",
						"background": "var(--wp--preset--color--primary-accent)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"width": "3px",
						"style": "solid",
						"offset": "3px"
					}
				}
			}
		},
		"blocks": {
			"core/cover": {
				"dimensions": {
					"minHeight": "70svh"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border-light)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "500"
				}
			},
			"core/navigation-link": {
				"typography": {
					"fontWeight": "500"
				}
			},
			"core/image": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		}
	},
	"customTemplates": [
		{ "name": "page-with-title", "title": "Page With Title", "postTypes": [ "page" ] },
		{ "name": "page-dark-header", "title": "Page (Dark Header)", "postTypes": [ "page" ] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "header-dark", "title": "Header (Dark)", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{
			"name": "simple-product-add-to-cart-with-options",
			"title": "Simple Product Add to Cart",
			"area": "add-to-cart-with-options"
		},
		{
			"name": "variable-product-add-to-cart-with-options",
			"title": "Variable Product Add to Cart",
			"area": "add-to-cart-with-options"
		}
	]
}
